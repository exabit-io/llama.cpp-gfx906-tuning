#!/usr/bin/python3 -I
"""gfx906-rccl-topology -- write the RCCL/NCCL topology file for the XGMI ring of the gfx906 GPUs in this machine.

The topology is derived from sysfs on every run, so PCI renumbering (cards added or moved, switch pools changing)
needs no manual edit.

Why RCCL needs a file at all: on the Mac Pro 7,1 with two Radeon Pro Vega II Duo modules and the A2326 bridge, the
XGMI hop table that the firmware reports (and KFD, rocm-smi and RCCL read) swaps the two bridge links. The physical
ring joins the die on the same switch port of each module (port 08 to port 08, port 10 to port 10); the firmware
says port 08 to port 10. Measured 2026-09-04 and 2026-11-06: RCCL all-reduce busbw 24.8 GB/s on the firmware links,
33.5-34.1 GB/s on the physical ring.

Rule, for each XGMI hive (KFD hive_id):
  module = the outermost PCIe switch above a GPU (first upstream port below the root port)
  die    = the downstream port of that switch the GPU hangs off, ordered by device number
  links  = the two dies of a module; with two modules in one hive (a bridge is present), the dies on the same
           port of each module.
A hive that does not fit this shape (other gfx906 hardware) gets the firmware's one-hop XGMI links, with a warning.
Every link is checked against KFD's XGMI table (the two GPUs must be XGMI peers). Only gfx906 is supported: the
file carries gfx906's RCCL attributes, and a machine with any other AMD GPU in KFD gets no file.

Usage: gfx906-rccl-topology generate [--output PATH] [--links rule|firmware] [--wait SECONDS]
       gfx906-rccl-topology show     [--links rule|firmware]
--wait waits for KFD to report every AMD GPU that is bound to amdgpu or not bound yet (amdgpu may still be loading).
Exit status: 0 written (or shown), or no AMD GPUs at all (nothing to do); 1 an unsupported GPU, no GPUs in KFD, or an
inconsistency: nothing is written, a file from an earlier run is moved to .stale, and RCCL then detects the topology
itself.

gfx906-rccl-topology.service rewrites /var/cache/gfx906-rccl-topology/topology.xml on every boot. The file is
regenerable data, so it lives in /var/cache; /etc/rccl.conf (NCCL_TOPO_FILE) points RCCL at it, and an admin who wants
a hand-made topology repoints that line. Nothing in /etc is ever written by this tool.
"""
import argparse
import os
import sys
import tempfile
import time

VERSION = "1.0.0"
NAME = "gfx906-rccl-topology"
DEFAULT_OUTPUT = "/var/cache/gfx906-rccl-topology/topology.xml"
KFD = "/sys/class/kfd/kfd/topology/nodes"
PCI = "/sys/bus/pci/devices"
XGMI_LINK_TYPE = 11            # CRAT_IOLINK_TYPE_XGMI
GPU_CLASSES = ("0x0300", "0x0380", "0x1200")                    # VGA, other display, processing accelerator
GPU_ATTRS = {90006: dict(gcn="gfx906", sm="64", arch="38911")}   # as RCCL dumps them for gfx906


def log(msg):
    print(NAME + ": " + msg, file=sys.stderr)


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def props(path):
    out = {}
    for line in (read(path, "") or "").splitlines():
        k, _, v = line.partition(" ")
        if v:
            out[k] = v
    return out


def gfx_name(v):
    return "gfx%d%x%x" % (v // 10000, (v // 100) % 100, v % 100)


def pcie_port_type(bdf):
    """PCIe capability device/port type: 0/1 endpoint, 4 root port, 5 upstream, 6 downstream; None if absent.
    Reading config space past 64 bytes needs CAP_SYS_ADMIN."""
    try:
        with open(os.path.join(PCI, bdf, "config"), "rb") as f:
            cfg = f.read(256)
    except OSError:
        return None
    if len(cfg) < 0x40 or not (cfg[0x06] & 0x10):     # no capability list
        return None
    p, seen = cfg[0x34] & 0xFC, set()
    while p and p not in seen and p + 3 < len(cfg):
        seen.add(p)
        if cfg[p] == 0x10:
            return (cfg[p + 2] >> 4) & 0xF
        p = cfg[p + 1] & 0xFC
    return None


def kfd_gpus():
    """GPU nodes in KFD node order (= HIP device order)."""
    gpus = []
    if not os.path.isdir(KFD):
        return gpus
    for name in sorted(os.listdir(KFD), key=lambda s: int(s) if s.isdigit() else 1 << 30):
        node = os.path.join(KFD, name)
        p = props(os.path.join(node, "properties"))
        if int(p.get("simd_count", "0")) == 0:
            continue
        loc, dom = int(p.get("location_id", "0")), int(p.get("domain", "0"))
        bdf = "%04x:%02x:%02x.%x" % (dom, loc >> 8, (loc >> 3) & 0x1F, loc & 7)
        links = {}
        ldir = os.path.join(node, "io_links")
        for l in (os.listdir(ldir) if os.path.isdir(ldir) else []):
            lp = props(os.path.join(ldir, l, "properties"))
            if int(lp.get("type", "-1")) == XGMI_LINK_TYPE:
                links[int(lp["node_to"])] = int(lp.get("weight", "0"))
        gpus.append(dict(node=int(name), bdf=bdf, hive=int(p.get("hive_id", "0")),
                         gfx=int(p.get("gfx_target_version", "0")), xgmi=links))
    for dev, g in enumerate(gpus):
        g["dev"] = dev
        g["path"] = os.path.realpath(os.path.join(PCI, g["bdf"])).split("/")[3:]   # pci0000:xx stripped
    return gpus


def amd_gpu_functions():
    """AMD GPU PCI functions -> the driver each is bound to ('' while unbound)."""
    out = {}
    for bdf in os.listdir(PCI):
        cls = read(os.path.join(PCI, bdf, "class"), "") or ""
        if read(os.path.join(PCI, bdf, "vendor")) == "0x1002" and cls[:6] in GPU_CLASSES:
            drv = os.path.join(PCI, bdf, "driver")
            out[bdf] = os.path.basename(os.path.realpath(drv)) if os.path.exists(drv) else ""
    return out


def module_and_die(g):
    """(module upstream port, die downstream port) of the outermost switch above the GPU, or (None, None)."""
    path = g["path"]
    for i, bdf in enumerate(path[:-1]):
        if pcie_port_type(bdf) == 5 and i + 1 < len(path) - 1 and pcie_port_type(path[i + 1]) == 6:
            return bdf, path[i + 1]
    return None, None


def firmware_links(hive):
    by_node = {g["node"]: g for g in hive}
    links = set()
    for g in hive:
        if not g["xgmi"]:
            continue
        w = min(g["xgmi"].values())
        for to, wt in g["xgmi"].items():
            if wt == w and to in by_node:
                links.add(tuple(sorted((g["dev"], by_node[to]["dev"]))))
    return links, "firmware one-hop XGMI links"


def rule_links(hive):
    modules = {}
    for g in hive:
        m, d = module_and_die(g)
        if m is None:
            return None, "GPU %s is not behind a PCIe switch" % g["bdf"]
        modules.setdefault(m, []).append((d, g))
    if any(len(v) != 2 for v in modules.values()) or len(modules) > 2:
        return None, "hive is not one or two modules of two GPUs (%s)" % \
            ", ".join("%s: %d" % (m, len(v)) for m, v in sorted(modules.items()))
    mods = [[g for _, g in sorted(v, key=lambda x: x[0])] for _, v in sorted(modules.items())]
    links = {tuple(sorted((m[0]["dev"], m[1]["dev"]))) for m in mods}
    if len(mods) == 2:   # bridge: same switch port of each module
        links |= {tuple(sorted((mods[0][i]["dev"], mods[1][i]["dev"]))) for i in (0, 1)}
    return links, "physical ring rule (%d module%s)" % (len(mods), "s" if len(mods) > 1 else "")


def derive(gpus, mode):
    """dev -> sorted list of linked devs, plus a description per hive."""
    hives, notes, adj = {}, [], {g["dev"]: [] for g in gpus}
    for g in gpus:
        if g["hive"]:
            hives.setdefault(g["hive"], []).append(g)
    for hid, hive in sorted(hives.items()):
        links, why = (None, "") if mode == "firmware" else rule_links(hive)
        if links is None:
            if mode != "firmware":
                log("hive %x: %s; using the firmware links" % (hid, why))
            links, why = firmware_links(hive)
        by_dev = {g["dev"]: g for g in hive}
        for a, b in sorted(links):
            if by_dev[b]["node"] not in by_dev[a]["xgmi"]:
                raise SystemExit("%s: %s and %s are linked by the rule but are not XGMI peers in KFD" %
                                 (NAME, by_dev[a]["bdf"], by_dev[b]["bdf"]))
            adj[a].append(b)
            adj[b].append(a)
        notes.append("hive %x: %s: %s" % (hid, why, ", ".join("%s-%s" % (by_dev[a]["bdf"][5:], by_dev[b]["bdf"][5:])
                                                               for a, b in sorted(links))))
    return {k: sorted(v) for k, v in adj.items()}, notes


def pci_attrs(bdf):
    d = os.path.join(PCI, bdf)
    speed = read(os.path.join(d, "current_link_speed"), "") or ""
    speed = speed if speed.endswith("PCIe") or not speed else speed + " PCIe"
    return ('busid="%s" class="%s" vendor="%s" device="%s" subsystem_vendor="%s" subsystem_device="%s" '
            'link_speed="%s" link_width="%s"' % (bdf, read(os.path.join(d, "class")), read(os.path.join(d, "vendor")),
                                                 read(os.path.join(d, "device")),
                                                 read(os.path.join(d, "subsystem_vendor")),
                                                 read(os.path.join(d, "subsystem_device")),
                                                 speed, read(os.path.join(d, "current_link_width"), "")))


def cpu_attrs(gpus):
    info = {}
    for line in (read("/proc/cpuinfo", "") or "").splitlines():
        k, _, v = line.partition(":")
        info.setdefault(k.strip(), v.strip())
    numa = int(read(os.path.join(PCI, gpus[0]["bdf"], "numa_node"), "-1") or -1)
    aff = read(os.path.join(PCI, gpus[0]["bdf"], "local_cpus"), "") or ""
    return 'numaid="%d" affinity="%s" arch="%s" vendor="%s" familyid="%s" modelid="%s"' % (
        max(numa, 0), aff, os.uname().machine, info.get("vendor_id", ""), info.get("cpu family", ""),
        info.get("model", ""))


def xml(gpus, adj):
    by_dev = {g["dev"]: g for g in gpus}
    tree = {}                                    # nested dict of upstream ports -> GPUs, as NCCL dumps it
    for g in gpus:
        node = tree
        for bdf in g["path"][:-1]:
            if pcie_port_type(bdf) == 5:
                node = node.setdefault(bdf, {})
        node[g["bdf"]] = g
    out = ['<system version="2">', '  <cpu %s>' % cpu_attrs(gpus)]

    def emit(node, depth):
        for bdf, child in sorted(node.items()):
            ind = "  " * depth
            out.append('%s<pci %s>' % (ind, pci_attrs(bdf)))
            if isinstance(child, dict) and "dev" in child:
                a = GPU_ATTRS[child["gfx"]]
                out.append('%s  <gpu dev="%d" sm="%s" gcn="%s" arch="%s" rank="%d" gdr="0">' %
                           (ind, child["dev"], a["sm"], a["gcn"], a["arch"], child["dev"]))
                for peer in adj[child["dev"]]:
                    out.append('%s    <xgmi target="%s" count="1" tclass="0x030000"/>' % (ind, by_dev[peer]["bdf"]))
                out.append('%s  </gpu>' % ind)
            else:
                emit(child, depth + 1)
            out.append('%s</pci>' % ind)
    emit(tree, 2)
    out += ['  </cpu>', '</system>', '']
    return "\n".join(out)


def retire(path):
    """Never leave a topology from an earlier run for RCCL to read: it may name PCI addresses that are gone, which
    makes RCCL initialisation fail. A missing file is harmless (RCCL reports it and detects the topology itself). The
    old file is kept beside it as .stale for inspection."""
    if os.path.exists(path):
        os.replace(path, path + ".stale")
        log("moved the previous %s to %s.stale; RCCL falls back to its own detection" % (path, path))


def collect(wait):
    """(AMD GPU PCI functions, KFD GPUs), once KFD reports every AMD GPU that is bound to amdgpu or not bound yet (so
    a boot where amdgpu is still loading waits; GPUs bound to another driver, such as vfio-pci, are not waited for),
    or when the wait runs out."""
    deadline = time.monotonic() + wait
    while True:
        fns, gpus = amd_gpu_functions(), kfd_gpus()
        want = sum(1 for d in fns.values() if d in ("", "amdgpu"))
        if not fns or want == 0 or (gpus and len(gpus) >= want):
            return fns, gpus
        if time.monotonic() >= deadline:
            log("after %gs KFD reports %d GPUs; %d AMD GPUs are bound to amdgpu or unbound" % (wait, len(gpus), want))
            return fns, gpus
        time.sleep(1)


def main():
    ap = argparse.ArgumentParser(prog=NAME, description=__doc__.split("\n")[0].split(" -- ")[1])
    ap.add_argument("--version", action="version", version="%s %s" % (NAME, VERSION))
    ap.add_argument("command", choices=["generate", "show"])
    ap.add_argument("--output", default=DEFAULT_OUTPUT, help="file to write (generate); default %(default)s")
    ap.add_argument("--links", choices=["rule", "firmware"], default="rule",
                    help="rule: the physical ring (default); firmware: KFD's one-hop XGMI links")
    ap.add_argument("--wait", type=float, default=0, help="seconds to wait for KFD to report every AMD GPU")
    a = ap.parse_args()
    generate = a.command == "generate"

    fns, gpus = collect(a.wait)
    if not fns:
        log("no AMD GPUs; nothing to do")
        if generate:
            retire(a.output)
        return 0
    other = sorted({gfx_name(g["gfx"]) for g in gpus if g["gfx"] not in GPU_ATTRS})
    if other or not gpus:
        log(("KFD reports %s; only gfx906 is supported" % ", ".join(other)) if other else "no GPUs in KFD")
        log("nothing written")
        if generate:
            retire(a.output)
        return 1
    try:
        adj, notes = derive(gpus, a.links)
    except SystemExit:
        if generate:
            retire(a.output)
        raise
    for n in notes:
        log(n)
    text = xml(gpus, adj)
    if not generate:
        sys.stdout.write(text)
        return 0
    os.makedirs(os.path.dirname(a.output), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(a.output), prefix=".topo.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, a.output)
    log("wrote %s: %d GPUs, %d XGMI links" % (a.output, len(gpus), sum(len(v) for v in adj.values()) // 2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
