+    bool          gate_alpha = false; // g = softplus(alpha + dt_bias[h]) * ssm_a[h]
+    float         eps_q      = 0.0f;
+    float         eps_k      = 0.0f;
+    const float * dt_bias    = nullptr;
+    const float * ssm_a      = nullptr;
+};
