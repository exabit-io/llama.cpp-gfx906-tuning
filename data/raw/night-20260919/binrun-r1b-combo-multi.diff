+        tmp = fmaf(x32, x32, tmp);
+        tmp = fmaf(v[1], v[1], tmp);
+        tmp = fmaf(x96, x96, tmp);
+        tmp = warp_reduce_sum<32>(tmp);
+        return __shfl_sync(0xffffffff, tmp, lane & 31, 64);
+    } else {
+        float ss = 0.0f;
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            ss += v[r] * v[r];
+        }
+        return warp_reduce_sum<warp_size>(ss);
+    }
