+    static __device__ __forceinline__ float name(const float x) {           \
+        float r;                                                            \
+        asm volatile(                                                       \
+            barrier                                                         \
+            vop_instr " %0, %1, %1 " dpp_ctrl " row_mask:0xf bank_mask:0xf" \
+            : "=v"(r) : "v"(x) : "memory");                                 \
+        return r;                                                           \
+    }
