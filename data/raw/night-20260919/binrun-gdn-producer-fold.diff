+        kind = L2;      // upstream build_gdn_l2_norm: scale(rms_norm(x, eps/n), 1/sqrt(n)); handled as an L2 fold of kind 1
+    } else if (node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_SIGMOID && (mask & 2)) {
