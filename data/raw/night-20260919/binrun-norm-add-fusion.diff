+static bool ggml_cuda_add_rms_norm_fusable(const ggml_cgraph * cgraph, const int i) {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_ADD_NORM");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (!enabled || i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
